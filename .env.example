# Copy this file to .env.development (local dev) and/or configure in your
# hosting provider (e.g. Netlify environment variables) for production.

# Protomaps basemap API key (https://protomaps.com/api)
# Keys are origin-restricted: create one for localhost, one for production.
VITE_PROTOMAPS_API_KEY=

# WebSocket config
VITE_WS_MODE=mock
VITE_WS_URL=ws://localhost:8080
